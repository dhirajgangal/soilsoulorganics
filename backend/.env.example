# Copy this file to .env and adjust it for your machine.
# These values are for local development only. Do not put real passwords here.

# SQLAlchemy uses this URL to open PostgreSQL.
DATABASE_URL=postgresql+psycopg://soilsoul:soilsoul@localhost:5432/soilsoul

# Browsers allowed to call the API. The React dev server uses port 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Address used inside password-reset emails. No slash at the end.
FRONTEND_URL=http://localhost:5173

# Optional mail server for forgot-password emails.
# Leave SMTP_HOST empty to print the reset link in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
